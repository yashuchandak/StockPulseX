# Copy to .env and fill these in. Keep .env private (chmod 600).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional. If supplied, /add validates symbols against the current NSE equity CSV
# and resolves the full company name. Otherwise symbols are syntax-checked and
# company names can be supplied as: /add SYMBOL | Company Name
NSE_SYMBOLS_CSV=data/nse_equity_symbols.csv

STOCKPULSE_DATA_DIR=data
ET_RSS_URL=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms
TELEGRAM_GETUPDATES_TIMEOUT=5
INITIAL_LOOKBACK_HOURS=18
HTTP_TIMEOUT_SECONDS=90

#defaults to Business Standard;
#RSS_SOURCE=economic_times
